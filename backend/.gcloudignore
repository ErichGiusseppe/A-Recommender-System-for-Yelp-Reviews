# .gcloudignore — lo que Cloud Build NO necesita subir a GCS.
# El Dockerfile usa los datos de data/ pero esos se manejan por capas de caché.
# Solo subimos el código fuente y los artefactos imprescindibles.

.gcloudignore
.gitignore
.git

# Raw Yelp dataset — 8.7GB, solo para generar parquets
data/yelp_dataset/

# Fotos JPG — 7.3GB, servidas desde gs://lantern-photos-rs26
# Se excluye solo el directorio de JPGs; photos.json (24MB) sí va en el build
data/real/photos/photos/

# Archives
data/*.zip

# Python cache
__pycache__/
.venv/
venv/
*.pyc
*.pyo

# Dev scripts y docs
generate_parquets.py
generate_reviews.py
generate_hours.py
generate_docs.py
generate_quick_ref.py
find_test_users.py
notebooks/
*.ipynb
REFACTOR_PLAN.md
