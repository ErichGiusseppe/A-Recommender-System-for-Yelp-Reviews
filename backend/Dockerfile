FROM python:3.11-slim

WORKDIR /app

# System deps for implicit (BLAS) and pandas
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy app source
COPY app/ ./app/

# Copy pre-computed data artefacts (parquets + mock JSON)
# top_n.parquet and explanations.parquet are generated by notebooks/01_train.ipynb
COPY data/ ./data/

EXPOSE 8080

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080"]
